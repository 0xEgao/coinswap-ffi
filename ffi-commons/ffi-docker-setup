#!/bin/bash

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OPENSWAP_REPO="https://github.com/citadel-foss/openswap.git"
OPENSWAP_BRANCH="master"
OPENSWAP_DIR="$SCRIPT_DIR/.openswap-docker-stack"
IMAGE_NAME="openswap"
BITCOIN_IMAGE_NAME="bitcoin-mutinynet"
VERSION_FILE="latest"

# Static compose file describing the full regtest stack:
#   bitcoind + electrs + tor + 1 RPC maker (makerd1) + 1 Electrum maker (makerd2).
# Makers are production binaries: they expose Tor onion services and announce to
# the public Nostr relays; the taker discovers and dials them over Tor.
# The maker's legacy/taproot protocol is NOT a maker-side setting; it is chosen
# taker-side via SwapParams.protocol, so both taker protocols are exercised
# against the same protocol-agnostic makers.
COMPOSE_FILE="$SCRIPT_DIR/docker-compose.electrum-regtest.yml"

BITCOIN_RPC_PORT="18442"
BITCOIN_ZMQ_PORT="28332"
ELECTRUM_PORT="50001"
TOR_SOCKS_PORT="9050"
TOR_CONTROL_PORT="9051"
MAKER_STARTUP_TIMEOUT_SECONDS="${MAKER_STARTUP_TIMEOUT_SECONDS:-120}"
MAKER_RESTART_LIMIT="${MAKER_RESTART_LIMIT:-3}"
STACK_READY_TIMEOUT_SECONDS="${STACK_READY_TIMEOUT_SECONDS:-300}"

# RPC maker (Bitcoin Core backend) and Electrum maker (electrs backend).
RPC_MAKERS=("makerd1")
ELECTRUM_MAKERS=("makerd2")
ALL_MAKERS=("${RPC_MAKERS[@]}" "${ELECTRUM_MAKERS[@]}")

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

print_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

check_docker() {
    if ! command -v docker &> /dev/null; then
        print_error "Docker is not installed. Please install Docker first."
        exit 1
    fi

    if ! docker info &> /dev/null; then
        print_error "Docker is not running. Please start Docker first."
        exit 1
    fi
}

setup_openswap_repo() {
    if [ ! -d "$OPENSWAP_DIR" ]; then
        print_info "Cloning Openswap repository for Docker images..."
        git clone --depth 1 --branch "$OPENSWAP_BRANCH" "$OPENSWAP_REPO" "$OPENSWAP_DIR"
    else
        print_info "Updating Openswap repository at $OPENSWAP_DIR..."
        git -C "$OPENSWAP_DIR" remote set-url origin "$OPENSWAP_REPO"
        git -C "$OPENSWAP_DIR" fetch --depth 1 origin "$OPENSWAP_BRANCH"
        git -C "$OPENSWAP_DIR" checkout --detach FETCH_HEAD
    fi
}

generate_torrc() {
    local torrc_file="$SCRIPT_DIR/torrc.generated"
    print_info "Generating torrc configuration..."
    cat > "$torrc_file" << EOF
SocksPort 0.0.0.0:${TOR_SOCKS_PORT}
ControlPort 0.0.0.0:${TOR_CONTROL_PORT}
HashedControlPassword 16:16E946B27E1A526E602098661374FED04D4633D22A532202AD21F22D39
DataDirectory /var/lib/tor
EOF
    print_success "Generated torrc: $torrc_file"
}

build_image() {
    print_info "Building Openswap Docker image (branch: ${OPENSWAP_BRANCH})..."
    cd "$OPENSWAP_DIR"
    if docker build -f docker/Dockerfile -t "openswap/${IMAGE_NAME}:${OPENSWAP_BRANCH}" -t "openswap/${IMAGE_NAME}:latest" .; then
        print_success "Openswap image built successfully"
    else
        print_error "Failed to build Openswap image"
        exit 1
    fi
}

build_bitcoin_image() {
    print_info "Building Bitcoin Mutinynet Docker image..."
    cd "$OPENSWAP_DIR"
    if [ -f "docker/bitcoin-mutinynet.version" ]; then
        local tag=$(grep "^TAG=" "docker/bitcoin-mutinynet.version" | cut -d'=' -f2)
        local f_amd64=$(grep "^FILENAME_AMD64=" "docker/bitcoin-mutinynet.version" | cut -d'=' -f2)
        local s_amd64=$(grep "^SHA256_AMD64=" "docker/bitcoin-mutinynet.version" | cut -d'=' -f2)
        local f_arm64=$(grep "^FILENAME_ARM64=" "docker/bitcoin-mutinynet.version" | cut -d'=' -f2)
        local s_arm64=$(grep "^SHA256_ARM64=" "docker/bitcoin-mutinynet.version" | cut -d'=' -f2)
        local target_arch="${TARGETARCH:-}"

        if [ -z "$target_arch" ]; then
            case "$(uname -m)" in
                x86_64|amd64)
                    target_arch="amd64"
                    ;;
                arm64|aarch64)
                    target_arch="arm64"
                    ;;
                *)
                    print_error "Unsupported host architecture: $(uname -m)"
                    exit 1
                    ;;
            esac
        fi

        print_info "Using TARGETARCH=$target_arch for Bitcoin image build"

        if docker build \
            --build-arg TARGETARCH="$target_arch" \
            --build-arg TAG="$tag" \
            --build-arg FILENAME_AMD64="$f_amd64" \
            --build-arg SHA256_AMD64="$s_amd64" \
            --build-arg FILENAME_ARM64="$f_arm64" \
            --build-arg SHA256_ARM64="$s_arm64" \
            -f docker/Dockerfile.bitcoin-mutinynet \
            -t "openswap/${BITCOIN_IMAGE_NAME}:${tag}" \
            -t "openswap/${BITCOIN_IMAGE_NAME}:latest" .; then
            print_success "Bitcoin Mutinynet image built successfully"
        else
            print_error "Failed to build Bitcoin Mutinynet image"
            exit 1
        fi
    else
        print_error "Version file not found: docker/bitcoin-mutinynet.version"
        exit 1
    fi
}

start_stack() {
    check_docker
    generate_torrc
    print_info "Starting Openswap regtest stack (1 RPC + 1 Electrum maker)..."
    cd "$SCRIPT_DIR"
    if docker compose -f "$COMPOSE_FILE" up -d; then
        print_success "Openswap stack started successfully"
        docker compose -f "$COMPOSE_FILE" ps

        print_info "Waiting 10 seconds for services to initialize..."
        sleep 10

        fund_makers

        start_block_mining
    else
        print_error "Failed to start Openswap stack"
        exit 1
    fi
}

stop_stack() {
    print_info "Stopping Openswap stack..."
    cd "$SCRIPT_DIR"

    stop_block_mining

    if [ -f "$COMPOSE_FILE" ]; then
        print_info "Cleaning wallet directories in containers..."
        docker exec openswap-bitcoind sh -c "rm -rf /home/*" 2>/dev/null || true

        local container
        for container in "${ALL_MAKERS[@]}"; do
            docker exec "openswap-${container}" sh -c "rm -rf /home/openswap/.openswap/*" 2>/dev/null || true
        done

        docker compose -f "$COMPOSE_FILE" down -v
    fi
    print_success "Openswap stack stopped and cleaned up"
}

show_logs() {
    cd "$SCRIPT_DIR"
    if [ -n "$1" ]; then
        docker compose -f "$COMPOSE_FILE" logs -f "$1"
    else
        docker compose -f "$COMPOSE_FILE" logs -f
    fi
}

print_maker_startup_diagnostics() {
    local container_name="$1"

    print_error "${container_name} did not reach the wallet-funding stage."
    print_info "Container state:"
    docker inspect \
        --format 'status={{.State.Status}} exit_code={{.State.ExitCode}} restarts={{.RestartCount}} error={{.State.Error}}' \
        "$container_name" 2>&1 || true
    print_info "Recent ${container_name} logs:"
    docker logs --tail 200 "$container_name" 2>&1 || true
    print_info "Stack status:"
    docker compose -f "$COMPOSE_FILE" ps -a 2>&1 || true
}

wait_for_maker_funding_address() {
    local container_name="$1"
    local elapsed=0
    local maker_logs
    local container_status
    local restart_count

    MAKER_FUNDING_ADDRESS=""
    print_info "Waiting for ${container_name} to request wallet funding..."

    while [ "$elapsed" -lt "$MAKER_STARTUP_TIMEOUT_SECONDS" ]; do
        maker_logs=$(docker logs "$container_name" 2>&1 || true)
        MAKER_FUNDING_ADDRESS=$(printf '%s\n' "$maker_logs" \
            | grep "Send at least" \
            | tail -1 \
            | grep -Eo 'bcrt1[[:alnum:]]+' || true)

        if [ -n "$MAKER_FUNDING_ADDRESS" ]; then
            return 0
        fi

        container_status=$(docker inspect --format '{{.State.Status}}' "$container_name" 2>/dev/null || true)
        restart_count=$(docker inspect --format '{{.RestartCount}}' "$container_name" 2>/dev/null || true)

        if [ -z "$container_status" ] \
            || [ "$container_status" = "exited" ] \
            || [ "$container_status" = "dead" ] \
            || { [ "${restart_count:-0}" -ge "$MAKER_RESTART_LIMIT" ] 2>/dev/null; }; then
            print_maker_startup_diagnostics "$container_name"
            return 1
        fi

        sleep 2
        elapsed=$((elapsed + 2))
    done

    print_error "Timed out after ${MAKER_STARTUP_TIMEOUT_SECONDS}s waiting for ${container_name}."
    print_maker_startup_diagnostics "$container_name"
    return 1
}

wait_for_stack_ready() {
    local elapsed=0
    local maker_name
    local container_name
    local container_status
    local restart_count
    local started_at
    local maker_logs
    local setup_count
    local onion_count
    local all_ready

    check_docker
    print_info "Waiting for both makers to finish setup and publish onion addresses..."

    while [ "$elapsed" -lt "$STACK_READY_TIMEOUT_SECONDS" ]; do
        all_ready=true

        for maker_name in "${ALL_MAKERS[@]}"; do
            container_name="openswap-${maker_name}"
            container_status=$(docker inspect --format '{{.State.Status}}' "$container_name" 2>/dev/null || true)
            restart_count=$(docker inspect --format '{{.RestartCount}}' "$container_name" 2>/dev/null || true)

            if [ -z "$container_status" ] \
                || [ "$container_status" = "exited" ] \
                || [ "$container_status" = "dead" ] \
                || { [ "${restart_count:-0}" -ge "$MAKER_RESTART_LIMIT" ] 2>/dev/null; }; then
                print_maker_startup_diagnostics "$container_name"
                return 1
            fi

            if [ "$container_status" != "running" ]; then
                all_ready=false
                continue
            fi

            # Container logs survive restarts. Restrict readiness checks to the
            # current run so stale setup/onion messages cannot pass this gate.
            started_at=$(docker inspect --format '{{.State.StartedAt}}' "$container_name" 2>/dev/null || true)
            if [ -z "$started_at" ]; then
                all_ready=false
                continue
            fi
            maker_logs=$(docker logs --since "$started_at" "$container_name" 2>&1 || true)
            setup_count=$(printf '%s\n' "$maker_logs" | grep -c "Server setup complete" || true)
            onion_count=$(printf '%s\n' "$maker_logs" | grep -c "Generated new Tor Hidden Service Hostname" || true)
            if [ "$setup_count" -lt 1 ] || [ "$onion_count" -lt 1 ]; then
                all_ready=false
            fi
        done

        if $all_ready; then
            print_success "Both local makers are ready"
            return 0
        fi

        sleep 5
        elapsed=$((elapsed + 5))
        print_info "Still waiting for makers (${elapsed}/${STACK_READY_TIMEOUT_SECONDS}s)..."
    done

    print_error "Timed out after ${STACK_READY_TIMEOUT_SECONDS}s waiting for the local makers."
    docker compose -f "$COMPOSE_FILE" ps -a 2>&1 || true
    for maker_name in "${ALL_MAKERS[@]}"; do
        print_maker_startup_diagnostics "openswap-${maker_name}"
    done
    return 1
}

fund_makers() {
    print_info "Funding makers with Bitcoin (regtest)..."

    print_info "Creating Bitcoin wallet..."
    docker exec openswap-bitcoind bitcoin-cli -regtest -rpcport=$BITCOIN_RPC_PORT -rpcuser=user -rpcpassword=password createwallet "test" 2>/dev/null || true

    print_info "Mining initial blocks for coinbase maturity..."
    local addr=$(docker exec openswap-bitcoind bitcoin-cli -regtest -rpcport=$BITCOIN_RPC_PORT -rpcuser=user -rpcpassword=password -rpcwallet=test getnewaddress)
    docker exec openswap-bitcoind bitcoin-cli -regtest -rpcport=$BITCOIN_RPC_PORT -rpcuser=user -rpcpassword=password generatetoaddress 101 "$addr"

    local total_rounds=${#ALL_MAKERS[@]}
    local current_round=0

    local maker_name
    for maker_name in "${ALL_MAKERS[@]}"; do
        current_round=$((current_round + 1))
        local container_name="openswap-${maker_name}"
        print_info "Funding ${maker_name}..."
        local maker_addr
        if ! wait_for_maker_funding_address "$container_name"; then
            return 1
        fi
        maker_addr="$MAKER_FUNDING_ADDRESS"

        print_info "${maker_name} address: $maker_addr"
        for _ in 1 2 3 4; do
            docker exec openswap-bitcoind bitcoin-cli -regtest -rpcport=$BITCOIN_RPC_PORT -rpcuser=user -rpcpassword=password -rpcwallet=test sendtoaddress "$maker_addr" 0.25
        done
        print_success "Sent 4x 0.25 BTC (1 BTC total) to ${maker_name}"

        # Pause between rounds so maker funding has a predictable cadence.
        if [ "$current_round" -lt "$total_rounds" ]; then
            sleep 3
        fi
    done

    print_success "Makers funded successfully!"
    echo ""
    echo "Maker wallets:"
    echo "  RPC makers      : ${RPC_MAKERS[*]}"
    echo "  Electrum makers : ${ELECTRUM_MAKERS[*]}"
}

mine_blocks() {
    local addr=$(docker exec openswap-bitcoind bitcoin-cli \
        -regtest -rpcport=$BITCOIN_RPC_PORT -rpcuser=user -rpcpassword=password \
        -rpcwallet=test getnewaddress 2>/dev/null)

    docker exec openswap-bitcoind bitcoin-cli \
        -regtest -rpcport=$BITCOIN_RPC_PORT -rpcuser=user -rpcpassword=password \
        generatetoaddress 1 "$addr" > /dev/null 2>&1
}

start_block_mining() {
    local pidfile="$SCRIPT_DIR/.block-mining.pid"

    if [ -f "$pidfile" ]; then
        local pid=$(cat "$pidfile")
        if ps -p "$pid" > /dev/null 2>&1; then
            print_warning "Block mining already running (PID: $pid)"
            return 0
        fi
    fi

    # Mine one block every 20s. Fast enough to confirm fidelity bonds and
    # funding promptly, but slow enough that a multi-hop openswap over Tor
    # completes well within its refund timelock window (~31 blocks of headroom).
    # A 5s cadence raced past the swap timelock and broke Taproot swaps.
    print_info "Starting automatic block mining (every 20 seconds)..."

    nohup bash -c '
        while true; do
            if ! docker ps --format "{{.Names}}" | grep -q "^openswap-bitcoind$"; then
                break
            fi
            "'"$SCRIPT_DIR"'/ffi-docker-setup" mine
            sleep 20
        done
    ' > "$SCRIPT_DIR/.block-mining.log" 2>&1 &

    local mining_pid=$!
    echo "$mining_pid" > "$pidfile"
    print_success "Block mining started (PID: $mining_pid)"
}

stop_block_mining() {
    local pidfile="$SCRIPT_DIR/.block-mining.pid"

    if [ -f "$pidfile" ]; then
        local pid=$(cat "$pidfile")
        if ps -p "$pid" > /dev/null 2>&1; then
            print_info "Stopping block mining (PID: $pid)..."
            kill "$pid" 2>/dev/null || true
            # Wait a bit and force kill if needed
            sleep 1
            kill -9 "$pid" 2>/dev/null || true
            print_success "Block mining stopped"
        fi
        rm -f "$pidfile"
    fi
}

show_help() {
    echo "Openswap Docker Setup Script (regtest, fixed 1 RPC + 1 Electrum maker)"
    echo ""
    echo "Usage: $0 [COMMAND] [ARGS]"
    echo ""
    echo "Commands:"
    echo "  setup               Setup environment (clone repo, build images)"
    echo "  build               Build the Openswap Docker image"
    echo "  build-bitcoin       Build the Bitcoin Mutinynet Docker image"
    echo "  start               Start the full stack (bitcoind + electrs + tor + 2 makers)"
    echo "  wait-ready          Wait until both makers are ready for live tests"
    echo "  stop                Stop the Openswap stack and block mining"
    echo "  restart             Restart the Openswap stack"
    echo "  fund-makers         Manually fund maker wallets (done automatically on start)"
    echo "  mine                Manually mine a block (auto-mining runs every 20s)"
    echo "  start-mining        Start automatic block mining"
    echo "  stop-mining         Stop automatic block mining"
    echo "  logs [service]      Show logs (bitcoind, electrs, tor, makerd1, makerd2)"
    echo "  status              Show status of running services"
    echo ""
    echo "Makers:"
    echo "  makerd1             Bitcoin Core RPC backend"
    echo "  makerd2             Electrum (electrs) backend"
    echo ""
    echo "Examples:"
    echo "  $0 setup            # First time setup"
    echo "  $0 start            # Start the full stack"
    echo "  $0 logs makerd2     # View electrum makerd2 logs"
}

# Parse command-line arguments
COMMAND="${1:-}"
shift || true

while [[ $# -gt 0 ]]; do
    case "$1" in
        *)
            # Store first extra argument for subcommands (e.g., service name)
            if [[ -z "${SUBCOMMAND_ARG:-}" ]]; then
                SUBCOMMAND_ARG="$1"
            fi
            shift
            ;;
    esac
done

case "$COMMAND" in
    "setup")
        check_docker
        setup_openswap_repo
        build_bitcoin_image
        build_image
        print_success "Setup complete! Run '$0 start' to start services"
        ;;
    "build")
        check_docker
        build_image
        ;;
    "build-bitcoin")
        check_docker
        build_bitcoin_image
        ;;
    "start")
        check_docker
        # A maker-count argument is accepted for backwards compatibility with
        # existing CI invocations (e.g. `start 4`) but is ignored: the stack is
        # a fixed 2-maker topology (1 RPC + 1 Electrum) defined in the compose file.
        if [[ -n "${SUBCOMMAND_ARG:-}" ]]; then
            print_info "Ignoring maker-count argument '${SUBCOMMAND_ARG}': stack topology is fixed (1 RPC + 1 Electrum maker)."
        fi
        start_stack
        ;;
    "wait-ready")
        wait_for_stack_ready
        ;;
    "stop")
        stop_stack
        ;;
    "restart")
        stop_stack
        sleep 2
        start_stack
        ;;
    "fund-makers")
        fund_makers
        ;;
    "mine")
        mine_blocks
        ;;
    "start-mining")
        start_block_mining
        ;;
    "stop-mining")
        stop_block_mining
        ;;
    "logs")
        show_logs "${SUBCOMMAND_ARG:-}"
        ;;
    "status")
        cd "$SCRIPT_DIR"
        docker compose -f "$COMPOSE_FILE" ps 2>/dev/null || echo "No stack running"
        pidfile="$SCRIPT_DIR/.block-mining.pid"
        if [ -f "$pidfile" ]; then
            pid=$(cat "$pidfile")
            if ps -p "$pid" > /dev/null 2>&1; then
                echo "Block mining: RUNNING (PID: $pid)"
            else
                echo "Block mining: STOPPED"
            fi
        else
            echo "Block mining: STOPPED"
        fi
        ;;
    "help"|"--help"|"-h"|"")
        show_help
        ;;
    *)
        print_error "Unknown command: $COMMAND"
        echo ""
        show_help
        exit 1
        ;;
esac
